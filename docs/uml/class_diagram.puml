@startuml Class Diagram - Boolean Circuit Editor

package "Frontend (PyQt6)" {
    class MainWindow {
        -controller : AppController
        -scene : CircuitScene
        -view : CircuitView
        +add_node()
        +connect_pins()
        +undo()
        +redo()
    }

    class CircuitScene {
        -controller : AppController
        -nodes : dict
        -lines : list
        +sync_scene()
        +on_pin_clicked()
        +mousePressEvent()
    }

    class NodeItem
    class PinItem
    class ConnectionLine
}

package "Backend" {
    class AppController {
        -circuit : Circuit
        -history : CommandHistory
        -factory : CommandFactory
        +add_node()
        +connect_pins()
        +simplify_circuit()
        +get_polynomials()
        +undo()
        +redo()
    }

    interface Command {
        +execute()
        +undo()
    }

    class CommandHistory {
        -undo_stack
        -redo_stack
        +execute(Command)
        +undo()
        +redo()
    }

    class CommandFactory

    class Circuit {
        -_nodes : List<CircuitNode>
        -connections
        +accept(Visitor)
        +validate_structure()
    }

    interface SchemeComponent {
        +accept(visitor)
    }

    abstract class CircuitNode {
        +node_id
        +node_type
        +accept(visitor)
    }

    interface CircuitVisitor
}

' Relationships
MainWindow --> AppController
MainWindow --> CircuitScene
CircuitScene --> NodeItem
CircuitScene --> ConnectionLine
CircuitScene --> AppController

AppController --> Circuit
AppController --> CommandHistory
AppController --> CommandFactory

Circuit "1" *-- "many" CircuitNode
Circuit --|> SchemeComponent
CircuitNode --|> SchemeComponent

Command <|-- AddNodeCommand
Command <|-- RemoveNodeCommand
Command <|-- ConnectPinsCommand
Command <|-- MoveNodeCommand

CircuitVisitor <|.. NodeRolesVisitor

@enduml